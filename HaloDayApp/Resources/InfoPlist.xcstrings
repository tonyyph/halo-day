    "NSCalendarsFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halo Day reads your calendar to draw your day on the Orbit and in your widgets. Your events never leave your iPhone."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halo Day đọc lịch của bạn để vẽ ngày lên Orbit và widget. Sự kiện của bạn không bao giờ rời khỏi iPhone."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halo Day uses your approximate location only to match the sky to your sunrise and sunset. It never leaves your iPhone."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halo Day chỉ dùng vị trí gần đúng để khớp bầu trời với giờ mặt trời mọc và lặn. Vị trí không bao giờ rời khỏi iPhone."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halo Day saves the wallpapers you make to your photo library. It never reads your photos."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halo Day lưu hình nền bạn tạo vào thư viện ảnh. Ứng dụng không bao giờ đọc ảnh của bạn."
          }
        }
      }
    }
  },
  "version" : "1.0"
